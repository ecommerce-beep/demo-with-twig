<div 
								class="{{class}}" 
								data-sal="slide-left" 
								data-sal-duration="500" 
								data-sal-delay="350" 
								data-sal-easing="ease-out-sine" 
								data-sal-repeat="true"
								>

								
									<div class="flex flex-col justify-center gap-2 md:gap-4 container">

										<div>
											<h2 class="text-[clamp(0.875rem,0.8391rem+0.1609vw,1rem)]  font-medium text-background
											text-center ltr:md:text-start rtl:md:text-end 
											">
											{{ trans('footer.newsletter_title') }}
											</h2>
										</div>

										<form 
											action="{{ theme.settings.get('newsletter_url') }}" 
											method="post"
											id="mc-embedded-subscribe-form"
											name="mc-embedded-subscribe-form"
											class="mc-embedded-subscribe-form validate flex flex-col md:flex-row justify-between items-start md:items-center leading-none rounded-[3.35px]"
											target="_blank"
											novalidate
											>
											<div class="flex items-center gap-2 w-full">

												<input
													type="email"
													name="EMAIL"
													id="mce-EMAIL"
													class="mce-EMAIL w-full rtl:text-right ltr:text-left text-[clamp(0.75rem,0.7141rem+0.1609vw,0.875rem))] rounded-lg border-0 font-normal outline-none placeholder:text-primary placeholder:opacity-[48%] bg-secondary focus:border-primary text-primary focus:placeholder-transparent h-[40px] md:h-[52px]"
													placeholder="{{ trans('footer.newsletter_input_placeholder') }}"
												/>

												<button 
													name="subscribe"
													id="mc-embedded-subscribe"
													type="submit"
													class="mc-embedded-subscribe text-background   bg-primary hover:text-primary border border-background hover:bg-background rounded-lg flex items-center justify-center px-4 py-2 md:p-5 hover:opacity-90 transition-all h-[40px] md:h-[52px] text-[14px] font-medium leading-[100%]"
												>
													{{ trans('footer.newsletter_button') }}
													
												</button>

											</div>
										</form>

									</div>


							</div>
                            <script>
	document.addEventListener('DOMContentLoaded', function () {
		// Use querySelectorAll to get all forms on the page
		const forms = document.querySelectorAll('.mc-embedded-subscribe-form');
		if (!forms.length) return;

		const isRTL = document.documentElement.dir === 'rtl';

		const messages = {
			required: isRTL ? 'الرجاء إدخال بريد إلكتروني صحيح' : 'Please enter a valid email',
			invalid: isRTL ? 'صيغة البريد الإلكتروني غير صحيحة' : 'Invalid email format',
			success: isRTL ? 'تم الاشتراك بنجاح! شكراً لك' : 'Subscription successful! Thank you',
			sending: isRTL ? 'جاري الإرسال...' : 'Sending...'
		};

		// Loop through all forms on the page
		forms.forEach(form => {
			// Find elements within each form
			const emailInput = form.querySelector('.mce-EMAIL');
			const submitBtn = form.querySelector('.mc-embedded-subscribe');
			
			if (!emailInput || !submitBtn) return;

			emailInput.addEventListener('input', function () {
				this.setCustomValidity('');
			});

			emailInput.addEventListener('invalid', function () {
				this.setCustomValidity(messages.required);
				salla.notify.error(messages.required);
			});

			form.addEventListener('submit', function (e) {
				e.preventDefault();

				const emailValue = emailInput.value.trim();
				const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

				if (!emailRegex.test(emailValue)) {
					salla.notify.error(messages.invalid);
					return;
				}

				submitBtn.disabled = true;
				const originalText = submitBtn.textContent;
				submitBtn.textContent = messages.sending;

				fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					mode: 'no-cors'
				})
				.then(() => {
					salla.notify.success(messages.success);
					form.reset();
				})
				.catch(error => {
					console.error('Subscription error:', error);
					salla.notify.error(isRTL ? 'حدث خطأ أثناء الاشتراك' : 'An error occurred during subscription');
				})
				.finally(() => {
					submitBtn.disabled = false;
					submitBtn.textContent = originalText;
				});
			});
		});
	});
</script>
